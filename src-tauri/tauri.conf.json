{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Checktask Explorer",
  "version": "0.1.0",
  "identifier": "com.checktask.explorer",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 3000",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:desktop:web",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Checktask Explorer",
        "width": 1480,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 740,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.ico", "icons/icon-128.png", "icons/icon-256.png"]
  }
}
